      "text": "\"\"\"Publish the verified primary archive and explicit historical recovery supplement.\"\"\"\nfrom pathlib import Path\nsource = Path(__file__).with_name('publish62.py')\ncode = source.read_text(encoding='utf8')\ncheck = '''recovery = json.loads((directory / 'recovery-index.json').read_bytes())\nassert recovery['status'] == 'passed' and recovery['byte_reproducible']\nfor item in recovery['archives']:\n    assert row(item['path']) == {key: item[key] for key in ('path', 'bytes', 'sha256')}\n'''\nassert code.count('paths = [') == 1\ncode = code.replace('paths = [', check + 'paths = [')\ncode = code.replace(\"for name in ('evidence.zip', 'inputs.json', 'index.json', 'review.json')\",\n                    \"for name in ('evidence.zip', 'inputs.json', 'index.json', 'review.json', 'recovery.zip', 'recovery-inputs.json', 'recovery-index.json', 'hardware-scope64.json')\")\nassert code.count('len(set(paths)) == 15') == 1\ncode = code.replace('len(set(paths)) == 15', 'len(set(paths)) == 19')\nexec(compile(code, str(source), 'exec'))\n"
