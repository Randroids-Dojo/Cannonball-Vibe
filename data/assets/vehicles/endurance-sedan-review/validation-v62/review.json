      "text": "\"\"\"Add exact missing historical inputs without altering the first archive.\"\"\"\nfrom pathlib import Path\nimport hashlib\nimport json\nimport shutil\nimport subprocess\n\nroot = Path.cwd().resolve()\nhere = Path(__file__).resolve().parent\ndestination = root / 'data/assets/vehicles/endurance-sedan-review/validation-v62'\nsource = root / 'reports/p1-018/qa/checkpoint62-retention-review01/supplement-inputs03.json'\nlock = destination / 'recovery-inputs.json'\nassert not lock.exists()\nvalue = json.loads(source.read_bytes())\nassert value['task_id'] == 'P1-018' and len(value['entries']) == 121\nbefore = hashlib.sha256(source.read_bytes()).hexdigest()\nshutil.copyfile(source, lock)\nassert hashlib.sha256(lock.read_bytes()).hexdigest() == before\nsubprocess.run(['python', 'tools/vehicles/endurance_sedan/retain_evidence.py',\n    '--manifest', str(lock), '--output', str(destination / 'recovery.zip'),\n    '--repeat-output', str(here / 'retention62-recovery-repeat.zip'),\n    '--index', str(destination / 'recovery-index.json')], check=True)\nassert hashlib.sha256(source.read_bytes()).hexdigest() == before\nprint(json.dumps({'status': 'supplement-retained-original-archive-unchanged',\n                  'entries': 121, 'input_sha256': before}))\n"
    },
