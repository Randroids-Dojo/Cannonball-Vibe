      "text": "\"\"\"Finalize the original checkpoint plus its separately preserved recovery archive.\"\"\"\nfrom pathlib import Path\nimport hashlib\nimport shutil\n\nhere = Path(__file__).resolve().parent\nroot = Path.cwd().resolve()\ndirectory = root / 'data/assets/vehicles/endurance-sedan-review/validation-v62'\nscope = here / 'hardware-end-scope64.json'\ncopied_scope = directory / 'hardware-scope64.json'\nassert not copied_scope.exists()\nshutil.copyfile(scope, copied_scope)\nassert hashlib.sha256(scope.read_bytes()).digest() == hashlib.sha256(copied_scope.read_bytes()).digest()\nsource = here / 'finalize62.py'\ncode = source.read_text(encoding='utf8')\ninsertion = '''recovery = read(destination / 'recovery-index.json')\nassert recovery['status'] == 'passed' and recovery['byte_reproducible']\nassert len(recovery['entries']) == 121\nfor item in recovery['archives']:\n    assert row(item['path']) == {key: item[key] for key in ('path', 'bytes', 'sha256')}\nretention['recovery_supplement'] = {\n    'manifest': row(destination / 'recovery-inputs.json'),\n    'index': row(destination / 'recovery-index.json'),\n    'archive': row(destination / 'recovery.zip'),\n    'entries': 121, 'byte_reproducible': True,\n    'scope': 'Exact missing historical report/source payloads and two independently hash-verified historical source reconstructions. Original606-entry archive remains unchanged.'}\n'''\nassert code.count('review = {') == 1\ncode = code.replace('review = {', insertion + 'review = {')\ncode = code.replace(\"glob('*-retention62.json')\", \"glob('*-retention62*.json')\")\ncode = code.replace(\"'limits': checkpoint['scope']\", \"'recovery_execution_tools': [{'artifact': row(here / name), 'text': (here / name).read_text(encoding='utf8')} for name in ('retain62_recovery.py', 'finalize62_recovered.py', 'publish62_recovered.py')],\\n    'planned_hardware_scope': row(destination / 'hardware-scope64.json'),\\n    'limits': checkpoint['scope']\")\ncode = code.replace(\"write(ledger_path, ledger)\", \"task['notes'] = task['notes'].replace('reports/p1-018/finish-branch40/hardware-end-scope64.json', 'data/assets/vehicles/endurance-sedan-review/validation-v62/hardware-scope64.json')\\nwrite(ledger_path, ledger)\")\nexec(compile(code, str(source), 'exec'))\n"
