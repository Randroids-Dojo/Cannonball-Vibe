  "diagnosis": {
    "pre_fix_balanced_neutral_cruise_speed_loss_meters_per_second_over_one_second": 4.009,
    "lift_off_hypothesis": "Physical deceleration was excessive rather than insufficient. The actual release defect was profile-dependent keyboard throttle decay followed by implicit rigid-body damping.",
    "pre_fix_keyboard_throttle_release_seconds": {
      "Accessible": 0.286,
      "Balanced": 0.2,
      "Raw": 0.125
    },
    "root_causes": [
      "direct steering yaw torque duplicated front tire yaw and rotated the chassis around its center",
      "lateral force ignored slip angle and measured normal load",
      "long suspension, center-of-mass height, strong upright stiffness, and weak tilt damping produced high-centered delayed lean",
      "digital steering reversal could spend an opposite pulse only canceling the previous command",
      "implicit body damping obscured aerodynamic, rolling, and engine coast forces"
    ]
  },
