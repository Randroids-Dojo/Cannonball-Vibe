  "acceptance": [
    {
      "criterion": "natural lift-off coast-down rather than hidden damping or brake masking",
      "status": "passed",
      "comparison": "all profiles released keyboard throttle in 3 frames, lost 4.016 m/s over 5 seconds against the declared 2-6 m/s band, gained at most 0.134 m/s after release, and used zero brake"
    },
    {
      "criterion": "bounded alternating-swerve recovery without brake input",
      "status": "passed",
      "comparison": "Accessible, Balanced, and Raw recovered in 0, 11, and 29 frames; all stayed above 0.94 final speed ratio and within 2.833 degrees of the initial heading"
    },
    {
      "criterion": "car-like yaw and lateral force from supported tire contact",
      "status": "passed",
      "comparison": "direct chassis steering torque was removed; unloaded tire force is zero; all slow-turn, moderate-turn, lane-change, departure, recovery, and incline bands passed"
    },
    {
      "criterion": "materially distinct profiles with a controllable common baseline",
      "status": "passed",
      "comparison": "Accessible has the greatest stabilization, Balanced is intermediate, and Raw has the least; swerve roll, yaw, slip, and recovery measurements remain distinct and ordered by demand"
    },
    {
      "criterion": "preserve concurrent controller tuning",
      "status": "passed",
      "comparison": "controller high-speed authority and controller throttle-release tuning remain on their existing profile values and are covered by focused regressions"
    },
    {
      "criterion": "frame rate, streaming, rebasing, save-resume, and deterministic replay equivalence",
      "status": "passed",
      "comparison": "30/60/144 FPS hashes matched; the refreshed 500-mile run recorded 1,362 rebases and nine equivalent resumes with zero route or save failures"
    }
