config_version=5

[application]
config/name="Cannonball Run"
run/main_scene="res://game/Main.tscn"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")

[display]
window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[dotnet]
project/assembly_name="Cannonball"

[editor]
export/convert_text_resources_to_binary=false

[importer_defaults]

; Every texture imports VRAM-compressed with mipmaps so sourced PBR maps never
; ship as raw RGBA. Normal-map detection is left to per-file .import settings.
texture={
"compress/mode": 2,
"compress/high_quality": true,
"mipmaps/generate": true,
"detect_3d/compress_to": 0
}

[input_devices]
joypads/ignore_joypad_on_unfocused_application=true

[physics]
; The car's transform only changes on a physics tick. Rendering runs far faster -
; over 1000 fps in reference captures - so without interpolation the car is held
; for several frames and then jumps, while the chase rig smooths every rendered
; frame. The car steps, the camera glides, and the relative motion reads as
; constant high-frequency bumping that no suspension, tyre or road change affects.
; Confirmed by capping render to the physics rate, which removed it.
common/physics_interpolation=true
common/physics_ticks_per_second=120
common/max_physics_steps_per_frame=16
3d/physics_engine="Jolt Physics"

[rendering]
renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
; Reference target is 2560x1440 High at 60 FPS on an RTX 3080 Ti (ADR-0023).
; 4x MSAA keeps alpha-scissored foliage and thin road markings clean at speed
; without the ghosting temporal AA shows on a car moving 90 m/s.
anti_aliasing/quality/msaa_3d=2
textures/default_filters/anisotropic_filtering_level=3
lights_and_shadows/directional_shadow/size=8192
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
environment/ssao/quality=2
environment/glow/upscale_mode=1
